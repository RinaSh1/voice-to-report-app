# Which LLM turns the transcript into a report: claude (default), ollama or openai
LLM_PROVIDER=claude

# Only needed if you don't use `ant auth login`. Never commit the real key.
# ANTHROPIC_API_KEY=

# Usage limits for the public demo (calls to /api/reports/generate)
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_PER_DAY=200
